@model IEnumerable<WebApplication1.Controllers.HomeController.Thuoc>
@{
    ViewBag.Title = "Quản Lý Thuốc - Clinic Care";
}

<style>
    body {
        background-color: #f4f7f6;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .page-title {
        color: #004d99;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 25px;
        letter-spacing: 1px;
        border-bottom: 3px solid #004d99;
        padding-bottom: 10px;
        display: inline-block;
    }

    /* Card Styles */
    .med-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        margin-bottom: 25px;
        overflow: hidden;
        border: none;
    }

    .med-header {
        background: linear-gradient(135deg, #004d99 0%, #0073e6 100%);
        color: white;
        padding: 15px 20px;
        font-size: 16px;
        font-weight: bold;
    }

    .med-header-red {
        background: linear-gradient(135deg, #cc0000 0%, #ff3333 100%);
    }

    .med-body {
        padding: 20px;
    }

    /* Buttons */
    .btn-med {
        background-color: #004d99;
        color: white;
        border-radius: 20px;
        padding: 8px 25px;
        font-weight: 600;
        transition: all 0.3s;
        border: none;
    }

        .btn-med:hover {
            background-color: #003366;
            color: white;
            box-shadow: 0 4px 8px rgba(0,0,0,0.15);
        }

    .btn-danger-med {
        background-color: #ff3333;
        color: white;
        border-radius: 20px;
        padding: 8px 20px;
        font-weight: bold;
        border: none;
        box-shadow: 0 4px 10px rgba(255, 51, 51, 0.3);
    }

        .btn-danger-med:hover {
            background-color: #cc0000;
            color: white;
        }

    /* Badges */
    .tag-kedon {
        background-color: #ff4d4d;
        color: white;
        padding: 4px 10px;
        border-radius: 15px;
        font-size: 11px;
        font-weight: bold;
    }

    .tag-tpcn {
        background-color: #2eb82e;
        color: white;
        padding: 4px 10px;
        border-radius: 15px;
        font-size: 11px;
        font-weight: bold;
    }

    /* Inputs */
    .form-control {
        border-radius: 8px;
        border: 1px solid #ced4da;
        box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);
        padding: 10px;
        height: auto;
    }

    table th {
        color: #004d99;
        border-bottom: 2px solid #004d99 !important;
    }

    table td {
        vertical-align: middle !important;
    }
</style>

<div class="container" style="margin-top: 30px;">
    <h2 class="page-title"><i class="glyphicon glyphicon-heart-empty"></i> Clinic Care - Hồ Sơ Bệnh Nhân</h2>

    <div class="row">
        <div class="col-md-4">

            <div class="med-card">
                <div class="med-header"><i class="glyphicon glyphicon-user"></i> Thông tin Sinh Hiệu</div>
                <div class="med-body">
                    <p style="font-size: 15px;"><b>Bệnh nhân:</b> Lỷ Nhân Thăng</p>
                    <p style="font-size: 15px;"><b>ID Bệnh án:</b> 1721030758</p>
                    <hr style="border-top: 1px dashed #ccc;" />

                    <form action="/Home/CapNhatSucKhoe" method="post">
                        <div class="row">
                            <div class="col-xs-6">
                                <label>Chiều cao (cm):</label>
                                <input type="number" name="ChieuCao" class="form-control" value="@(ViewBag.CC ?? 170)" required />
                            </div>
                            <div class="col-xs-6">
                                <label>Cân nặng (kg):</label>
                                <input type="number" name="CanNang" class="form-control" value="@(ViewBag.CN ?? 65)" required />
                            </div>
                        </div>

                        <div style="margin-top: 15px;">
                            @if (ViewBag.ErrorMsg != null)
                            {
                                <div class="alert alert-danger" style="border-radius: 8px;"><b>@ViewBag.ErrorMsg</b></div>
                            }
                            @if (ViewBag.SuccessMsg != null)
                            {
                                <div class="alert alert-success" style="border-radius: 8px;"><b>@ViewBag.SuccessMsg</b></div>
                            }
                        </div>

                        <button type="submit" class="btn btn-med btn-block" style="margin-top:15px;">Lưu Chỉ Số</button>
                    </form>
                    <div style="margin-top: 15px; text-align: center;">
                        <button type="button" class="btn btn-default" style="border-radius: 20px; width: 100%;"
                                onclick="alert('Lỗi truy xuất: Không có dữ liệu hồ sơ chi tiết để xuất PDF.')">
                            Xuất Hồ Sơ PDF
                        </button>
                    </div>
                </div>
            </div>

            <div class="med-card">
                <div class="med-header med-header-red"><i class="glyphicon glyphicon-warning-sign"></i> Giả Lập Hệ Thống SOS</div>
                <div class="med-body" style="text-align: center; padding: 30px 20px;">
                    <p style="color: #666; margin-bottom: 20px;">Mô phỏng trường hợp BN quên uống thuốc quá thời gian quy định (30 phút).</p>
                    <button type="button" class="btn btn-danger-med"
                            onclick="alert('🚨 HỆ THỐNG SOS KÍCH HOẠT:\n\nBệnh nhân Lỷ Nhân Thăng quá giờ uống thuốc 30 phút.\nĐÃ TỰ ĐỘNG GỬI SMS ĐẾN SĐT NGƯỜI NHÀ (090xxxxxxx)!')">
                        <i class="glyphicon glyphicon-phone"></i> Cảnh Báo Quá Giờ (SOS)
                    </button>
                </div>
            </div>

        </div>

        <div class="col-md-8">
            <div class="med-card">
                <div class="med-header"><i class="glyphicon glyphicon-calendar"></i> Phác Đồ Dùng Thuốc Hôm Nay</div>
                <div class="med-body">

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th width="40%">Tên Thuốc</th>
                                    <th width="20%">Giờ Uống</th>
                                    <th width="20%">Trạng Thái</th>
                                    <th width="20%">Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong style="font-size: 15px; color: #333;">@item.TenThuoc</strong><br />
                                            @if (item.Loai == "Thuốc Kê Đơn")
                                            {
                                                <span class="tag-kedon">Thuốc Kê Đơn</span>
                                            }
                                            else
                                            {

                                                <span class="tag-tpcn">Thực phẩm chức năng</span>
                                            }
                                        </td>
                                        <td>
                                            <span style="font-size: 18px; font-weight: bold; color: #004d99; background: #e6f2ff; padding: 5px 10px; border-radius: 8px;">
                                                <i class="glyphicon glyphicon-time"></i> @item.GioUong
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.DaUong)
                                            {
                                                <span style="color: #2eb82e; font-weight: bold; font-size: 14px;"><i class="glyphicon glyphicon-ok-circle"></i> Đã uống</span>
                                            }
                                            else
                                            {
                                                <span style="color: #ff9900; font-weight: bold; font-size: 14px;"><i class="glyphicon glyphicon-hourglass"></i> Chờ uống</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!item.DaUong)
                                            {
                                                <a href="/Home/XacNhanUong/@item.Id" class="btn btn-success btn-sm" style="border-radius: 20px; font-weight: bold;"
                                                   onclick="alert('✅ Đã ghi nhận ĐÃ UỐNG.\n\nĐang đồng bộ trạng thái lên Server và App của người thân...')">
                                                    Xác nhận uống
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <hr style="border-top: 2px dashed #e6e6e6; margin: 30px 0;" />

                    <h4 style="color: #004d99; font-weight: bold; margin-bottom: 15px;">Thêm Thuốc Mới Vào Phác Đồ</h4>
                    <form action="/Home/ThemThuoc" method="post" class="row">
                        <div class="col-md-5">
                            <input type="text" name="TenThuoc" class="form-control" placeholder="Nhập tên thuốc (Bắt buộc)..." required />
                        </div>
                        <div class="col-md-3">
                            <select name="Loai" class="form-control">
                                <option value="Thuốc Kê Đơn">Thuốc Kê Đơn</option>
                                <option value="TP Chức Năng">TP Chức Năng</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <input type="time" name="GioUong" class="form-control" required />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-med btn-block"><i class="glyphicon glyphicon-plus"></i> Tạo</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>